{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SaintHarness",
  "version": "0.2.0",
  "identifier": "io.saintharness.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SaintHarness",
        "width": 1280,
        "height": 840,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Pure Rust coding agent workspace",
    "longDescription": "SaintHarness native desktop app with an embedded Rust agent server, cross-model handoff, live workspace diffs, and OS sandboxed execution.",
    "linux": {
      "deb": {
        "section": "devel",
        "priority": "optional"
      }
    }
  }
}
